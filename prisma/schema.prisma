generator client {
  provider      = "prisma-client"
  output        = "../app/generated/prisma"
  runtime       = "workerd"
  compilerBuild = "small"
}

datasource db {
  provider = "postgresql"
}
model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  integrations Integration[]
  searchItems  SearchItem[]
}

model Integration {
  id                String   @id @default(cuid())

  // Relation
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Provider
  provider          String
  providerAccountId String

  // Display
  accountEmail      String?
  accountName       String?
  accountAvatar     String?

  // OAuth
  accessToken       String   @db.Text
  refreshToken      String?  @db.Text
  expiresAt         DateTime?

  // Metadata
  connectedAt       DateTime @default(now())
  lastSyncedAt      DateTime?
  isActive          Boolean  @default(true)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  searchItems       SearchItem[]
  syncCursor        SyncCursor?

  @@unique([provider, providerAccountId])
}

enum SearchItemKind {
  gmail_message
  drive_file
}

enum SyncStatus {
  idle
  running
  error
}

// NOTE: this table also has a generated `searchVector tsvector` column,
// added via raw SQL in prisma/migrations/<ts>_add_search_items/migration.sql.
// It is intentionally NOT declared here since Prisma can't model
// GENERATED ALWAYS AS (...) STORED columns — don't "fix" this by hand-adding
// it, read that migration file instead.
model SearchItem {
  id            String         @id @default(cuid())

  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  integrationId String
  integration   Integration    @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  provider      String         // "gmail" | "google_drive" | future providers
  kind          SearchItemKind

  externalId    String         // Gmail message id / Drive file id — upsert + tombstone key

  // Real typed columns because these are exactly what's ranked/highlighted/
  // sorted on; JSON would force ->> casts and defeat GIN/btree indexing.
  title         String         // Gmail subject | Drive file name
  participants  String         // flattened "From, To, Cc, Bcc" or owner names — trigram-indexed
  snippet       String?        @db.Text   // Gmail snippet | null for Drive
  bodyText      String?        @db.Text   // extracted text, truncated (~20k chars)
  url           String?        // webViewLink / Gmail permalink
  updatedAt     DateTime       // internalDate | modifiedTime — recency tiebreak

  // Provider-specific display-only payload (threadId, to/cc/bcc arrays,
  // mimeType, owners[], thumbnailLink) — never filtered/ranked/sorted on,
  // shape differs per provider/kind. Keeping this JSON (not typed columns)
  // is what keeps adding a provider a schema-stable operation.
  metadata      Json

  deletedAt     DateTime?      // reserved, unused (deletes are hard deletes)
  createdAt     DateTime       @default(now())
  syncedAt      DateTime       @default(now()) @updatedAt

  @@unique([integrationId, externalId])
  @@index([userId])
  @@index([userId, updatedAt])
}

model SyncCursor {
  id             String      @id @default(cuid())
  integrationId  String      @unique
  integration    Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  provider       String

  cursor         String?     // Gmail historyId / Drive startPageToken
  status         SyncStatus  @default(idle)
  lastError      String?     @db.Text
  lastSyncedAt   DateTime?
  lastFullSyncAt DateTime?

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @default(now()) @updatedAt
}
